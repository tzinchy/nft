# Домен, на который смотрит A-запись сервера (Caddy сам получит сертификат)
DOMAIN=tap.example.ru
# Адрес, который пишется в NFC-метки. Меняется только вместе с перезаписью всех меток!
PUBLIC_URL=https://tap.example.ru
# Секретный путь админки — придумайте свой
PANEL_PATH=/panel-change-me

# ЮKassa: Личный кабинет → Интеграция → Ключи API. Пусто — онлайн-оплата выключена.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — передавать чек (если в магазине подключена онлайн-касса / «Чеки от ЮKassa»)
YOOKASSA_RECEIPT=0

# Telegram: токен от @BotFather. Пусто — уведомления выключены.
TELEGRAM_BOT_TOKEN=
# Если api.telegram.org недоступен с сервера — прокси (socks5://user:pass@host:1080 или http://...)
HTTPS_PROXY=
# ...или свой локальный Bot API сервер
TELEGRAM_API=https://api.telegram.org
